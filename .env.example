# Local development defaults. Copy to .env if you want to override them.
# These are obvious local credentials for a synthetic demo, not production secrets.

POSTGRES_USER=billpilot
POSTGRES_PASSWORD=billpilot
POSTGRES_DB=billpilot

# Host-side tools (pytest, a local API). Compose overrides the host to "postgres".
DATABASE_URL=postgresql+psycopg://billpilot:billpilot@localhost:5432/billpilot

# Persona keys. The customer key is bound to CUSTOMER_NUMBER; the CSR key to CSR_CODE.
API_KEY_CUSTOMER=dev-customer-key
API_KEY_CSR=dev-csr-key
API_KEY_OPS=dev-ops-key
CUSTOMER_NUMBER=CUST-000001
CSR_CODE=CSR-A

# Generator. Counts can also be overridden with ANOMALY_COUNTS (JSON object).
SEED=42
CUSTOMER_COUNT=500
MONTHS=6
GROUND_TRUTH_PATH=data/ground_truth.json

LOG_LEVEL=INFO
RATE_LIMIT_CUSTOMER_PER_MINUTE=120
RATE_LIMIT_CSR_PER_MINUTE=300
RATE_LIMIT_OPS_PER_MINUTE=600

# Copilot. "fake" needs no key and is what CI uses. "api" calls LLM_BASE_URL.
# Any OpenAI-compatible host works. There is no local model runtime.
LLM_BACKEND=fake
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
# USD per million tokens for models that are not in the built-in table.
# Optional full override, JSON object keyed by model name:
# LLM_PRICE_TABLE={"gpt-4o-mini":{"prompt_per_million":"0.15","completion_per_million":"0.60"}}
LLM_PROMPT_PRICE_PER_MILLION=0.15
LLM_COMPLETION_PRICE_PER_MILLION=0.60

# Embeddings. "hash" is the default (no download, no spend). "api" uses LLM_BASE_URL/embeddings.
# "fake" is a deterministic test double. Reindex after changing this.
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=text-embedding-3-small

# The CLI sends tool calls here. The API process calls its own routes in-process.
BSS_BASE_URL=http://127.0.0.1:8000

AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_TOKENS=16000

# Tracing turns on only when all three are set. Leave the keys empty for the fake-model demo.
# Hobby setup: https://cloud.langfuse.com — see docs/deploy.md.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
